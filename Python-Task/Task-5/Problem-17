# Problem17: No Idea!
# https://www.hackerrank.com/challenges/no-idea/problem

n, m = map(int, input().split())
arr = list(map(int, input().split()))

A = set(map(int, input().split()))
B = set(map(int, input().split()))

happiness = 0

for number in arr:
    if number in A:
        happiness += 1
    elif number in B:
        happiness -= 1

print(happiness)
