# Problem 2: The Captain's Room
# HackerRank: https://www.hackerrank.com/challenges/py-the-captains-room/problem

k = int(input())
rooms = list(map(int, input().split()))
counts = {}

for room in rooms:
    counts[room] = counts.get(room, 0) + 1

for room, count in counts.items():
    if count == 1:
        print(room)
        break
